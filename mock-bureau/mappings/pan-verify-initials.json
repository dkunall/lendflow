{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/pan/verify",
    "bodyPatterns": [{ "matchesJsonPath": "$[?(@.pan =~ /[A-Z]{5}65[0-9]{2}[A-Z]/)]" }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "pan": "{{jsonPath request.body '$.pan'}}",
      "status": "VALID",
      "nameOnRecord": "A DESAI"
    },
    "transformers": ["response-template"]
  }
}
