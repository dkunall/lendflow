{
  "name": "PAN digits 5xxx: good history, high existing EMIs",
  "priority": 2,
  "request": {
    "method": "POST",
    "url": "/bureau/v1/credit-report",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.consent.version"
      },
      {
        "matchesJsonPath": "$[?(@.pan =~ /[A-Z]{5}5[0-9]{3}[A-Z]/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "bureauRef": "CIR-{{randomValue length=10 type='ALPHANUMERIC' uppercase=true}}",
      "hit": true,
      "score": 761,
      "activeAccounts": 4,
      "totalOutstanding": 1650000,
      "maxDpdLast12m": 0,
      "enquiriesLast6m": 2,
      "monthsOnBureau": 96,
      "writtenOff": false,
      "reportedEmi": 38000
    },
    "transformers": [
      "response-template"
    ]
  }
}
